<?xml version="1.0" encoding="UTF-8"?>

<?import com.example.demo.view.AssistanceToggle?>
<?import com.example.demo.view.TransportTypeBox?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16.0" styleClass="planner-card" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.demo.controller.TrajectorySelectionController">
    <padding>
        <Insets bottom="32.0" left="32.0" right="32.0" top="32.0"/>
    </padding>

    <Label text="OV-reisplanner" styleClass="app-title"/>

    <VBox spacing="14.0">
        <Label text="Plan je reis" styleClass="planner-title"/>

        <TransportTypeBox fx:id="transportTypeBox"/>

        <Label text="Zoeken" styleClass="field-label"/>
        <TextField fx:id="searchField"
                   styleClass="search-field"
                   promptText="Typ vertrek of aankomst, bijvoorbeeld Utrecht"
                   maxWidth="1.7976931348623157E308"/>

        <Label text="Route" styleClass="field-label"/>
        <HBox spacing="10.0">
            <ComboBox fx:id="routeBox"
                      styleClass="route-combo"
                      promptText="Selecteer een route"
                      maxWidth="1.7976931348623157E308"
                      HBox.hgrow="ALWAYS"/>
            <Button fx:id="swapButton" text="Wissel (↔)" styleClass="primary-button" onAction="#onSwap"/>
        </HBox>

        <Label fx:id="infoLabel" text="" styleClass="message-label"/>
    </VBox>

    <VBox VBox.vgrow="ALWAYS">
        <VBox fx:id="searchPane" spacing="8.0" managed="true" visible="true" maxHeight="165.0">
            <Label text="Reistijden" styleClass="field-label"/>
            <ListView fx:id="timesList" styleClass="times-list" prefHeight="150.0" minHeight="145.0"/>
        </VBox>

        <ScrollPane fx:id="detailsScrollPane"
                    managed="false"
                    visible="false"
                    fitToWidth="true"
                    styleClass="details-scroll"
                    VBox.vgrow="ALWAYS">
            <VBox fx:id="detailsPane" spacing="12.0" styleClass="details-pane">
                <Label text="Reisdetails" styleClass="section-title"/>

                <GridPane hgap="15.0" vgap="10.0">
                    <columnConstraints>
                        <ColumnConstraints maxWidth="120.0"/>
                        <ColumnConstraints maxWidth="1.7976931348623157E308" hgrow="ALWAYS"/>
                    </columnConstraints>

                    <Label text="Vertrekstation:" styleClass="detail-key" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <Label fx:id="detailsDeparture" text="-" styleClass="detail-value" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                    <Label text="Aankomststation:" styleClass="detail-key" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                    <Label fx:id="detailsArrival" text="-" styleClass="detail-value" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                    <Label text="Vertrektijd:" styleClass="detail-key" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                    <Label fx:id="detailsDepartureTime" text="-" styleClass="detail-value" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                    <Label text="Aankomsttijd:" styleClass="detail-key" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                    <Label fx:id="detailsArrivalTime" text="-" styleClass="detail-value" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                    <Label text="Reisduur:" styleClass="detail-key" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                    <Label fx:id="detailsDuration" text="-" styleClass="detail-value" GridPane.columnIndex="1" GridPane.rowIndex="4"/>

                    <Label text="Vervoerstype:" styleClass="detail-key" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
                    <Label fx:id="detailsTransportType" text="-" styleClass="detail-value" GridPane.columnIndex="1" GridPane.rowIndex="5"/>

                    <Label text="Beschikbare tijden:" styleClass="detail-key" GridPane.columnIndex="0" GridPane.rowIndex="6"/>
                    <Label fx:id="detailsTimes" text="-" styleClass="detail-value" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="6"/>
                </GridPane>

                <HBox spacing="10.0" styleClass="details-actions">
                    <Button fx:id="backButton" text="Terug"/>
                </HBox>
            </VBox>
        </ScrollPane>
    </VBox>

    <AssistanceToggle/>
</VBox>
